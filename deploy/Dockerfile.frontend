# Build stage: compile the Vite frontend
FROM node:22-alpine AS build

WORKDIR /app
COPY web/VERSION ./VERSION
COPY web/CHANGELOG.md ./CHANGELOG.md
COPY web/web/package.json web/web/package-lock.json ./web/

WORKDIR /app/web
RUN npm config set registry https://registry.npmmirror.com && npm install --no-audit --no-fund --legacy-peer-deps

COPY web/web ./
RUN npm run build

# Runtime stage: nginx serves static files and proxies API to backend
FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html

EXPOSE 80
