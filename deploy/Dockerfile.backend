FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt requirements-render-core.txt ./
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt

COPY commercial_app.py rate_limit.py render_core.py manage.py seed_pricing.py ./

RUN mkdir -p /app/data /app/logs

EXPOSE 8792

CMD ["python", "-m", "uvicorn", "commercial_app:app", "--host", "0.0.0.0", "--port", "8792"]
