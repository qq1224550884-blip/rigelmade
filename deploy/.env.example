# ============ AI image channels (API keys) ============
# Each supports comma-separated keys for automatic rotation.
# When a key hits rate-limit, it enters 5-min cooldown and the pool picks the next one.
GRSAI_API_KEY=key1,key2,key3
NANO_BANANA_API_KEY=key1,key2
FAST_BANANA_API_KEY=your-key-here
# Channel base URLs: required, fill in with your own provider addresses.
# These are deployment-only config, never commit real provider domains into code.
GRSAI_BASE_URL=https://your-grsai-provider.example.com
NANO_BANANA_BASE_URL=https://your-banana-provider.example.com
FAST_BANANA_BASE_URL=https://your-fast-banana-provider.example.com
# ToAPIs is the active relay in this deployment. When TOAPIS_API_KEY is set, all
# image models route through toapis (async POST + poll). Base URL defaults to
# https://toapis.com when omitted.
TOAPIS_API_KEY=
# 大陆服务器直连域名：主用 toapis.cn，备用 api.toapis.cn。
# 注意：toapis.com 在大陆被 DNS 污染/阻断；toapis.xyz 的 A 记录已于 2026-08-28 失效。
TOAPIS_BASE_URL=https://toapis.cn
# 主域名 DNS 解析失败时自动切换的备用域名（逗号分隔）。
TOAPIS_BASE_URL_FALLBACKS=https://toapis.cn,https://api.toapis.cn
# 可选：仅供 ToAPIs 使用的专用 HTTPS 代理，不影响支付和其他对外请求。
# 域名可直连时留空即可；仅当需要经境外中转时才填写。
TOAPIS_PROXY_URL=

# ============ Commercial core config ============
# Production requires at least 32 random chars for auth tokens.
# Generate with: openssl rand -hex 32
COMMERCIAL_AUTH_SECRET=change-me-at-least-32-random-chars
# Public site origin (HTTPS), used for CORS. Example: https://ai.example.com
SITE_ORIGIN=https://rigelmade.com

# ============ Payment mode (set to true after merchant approval) ============
# When false: payment UI hidden, new users get welcome credits, pure free-tier mode.
COMMERCIAL_PAYMENT_ENABLED=false
# Credits granted to every new registration (0 = disabled).
COMMERCIAL_WELCOME_CREDITS=500
# Max total welcome credits per IP across all accounts (prevents registration farming).
# Defaults to the same as WELCOME_CREDITS if not set.
COMMERCIAL_WELCOME_CREDITS_PER_IP=500

# ============ WeChat Pay (fill after merchant approval) ============
WECHATPAY_MCHID=
WECHATPAY_APPID=
WECHATPAY_SERIAL_NO=
WECHATPAY_API_V3_KEY=
# Must match the notify URL configured in WeChat merchant platform
WECHATPAY_NOTIFY_URL=https://rigelmade.com/api/payments/wechat/notify
# Put merchant private key and platform cert into deploy/certs/ with fixed names
WECHATPAY_PRIVATE_KEY_PATH=/certs/apiclient_key.pem
WECHATPAY_PLATFORM_CERT_PATH=/certs/wechatpay_platform_cert.pem

# ============ Optional analytics ============
# ANALYTICS_GA4_ID=
# ANALYTICS_BAIDU_ID=
